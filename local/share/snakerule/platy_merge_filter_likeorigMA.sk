# naming conventions
#egrassi@godot:/mnt/trcanmed/snaketree/data/MA_cell_lines_MR$ ls platypus_recall/*WIDR_CLONE* | sed 's/platypus_recall\/GRCh38.d1.vd1__//1; s/\.platypus-recall\.vcf\.gz//1' | tr "\n" "," | sed 's/,/","/g'
## TOLTO 12H
WIDR=["WIDR_CLONE_12A_BULK","WIDR_CLONE_12_BULK","WIDR_CLONE_12I_BULK","WIDR_CLONE_2A_BULK","WIDR_CLONE_2_BULK","WIDR_CLONE_2D_BULK","WIDR_CLONE_2E_BULK"]#,"WIDR_CLONE_7B_BULK","WIDR_CLONE_7_BULK","WIDR_CLONE_7D_BULK","WIDR_CLONE_7E_BULK"]
WIDR_CL=["WIDR-12-1-A","WIDR-12-0","WIDR-12-1-I","WIDR-02-1-A","WIDR-02-0","WIDR-02-1-D","WIDR-02-1-E"]#,"WIDR-07-1-B","WIDR-07-0","WIDR-07-1-D","WIDR-07-1-E"]
WIDR_map=dict(zip(WIDR_CL, WIDR))
#DIFI=["DIFI_CLONE_11B_BULK","DIFI_CLONE_11_BULK","DIFI_CLONE_11G_BULK","DIFI_CLONE_11H_BULK","DIFI_CLONE_18_BULK","DIFI_CLONE_8A_BULK","DIFI_CLONE_8_BULK","DIFI_CLONE_8F_BULK","DIFI_CLONE_8H_BULK"]
#DIFI_CL=["DIFI-11-1-B","DIFI-11-0","DIFI-11-1-G","DIFI-11-1-H","DIFI-18-0","DIFI-08-1-A","DIFI-08-0","DIFI-08-1-F","DIFI-08-1-H"]
DIFI=["DIFI_CLONE_11B_BULK","DIFI_CLONE_11_BULK","DIFI_CLONE_11G_BULK","DIFI_CLONE_11H_BULK","DIFI_CLONE_8A_BULK","DIFI_CLONE_8_BULK","DIFI_CLONE_8F_BULK","DIFI_CLONE_8H_BULK"]
DIFI_CL=["DIFI-11-1-B","DIFI-11-0","DIFI-11-1-G","DIFI-11-1-H"]#,"DIFI-08-1-A","DIFI-08-0","DIFI-08-1-F","DIFI-08-1-H"]
all_map=dict(zip(DIFI_CL, DIFI))
all_map.update(WIDR_map)

# TODO ASK ci son i bulk in platy? Clone 18? (suoi T1 sono tutti ko)
#DIFI_BASELINE
#DIFI_CLONE_18A_BULK
#DIFI_CLONE_18D_BULK
