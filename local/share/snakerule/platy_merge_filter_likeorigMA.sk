rule map:
    output: cmap="clones_map.txt"
    run:
        with open(output.cmap, 'w') as outfile:
            for key, el in all_map.items():
                outfile.write("{el} {key}\n".format(el=el, key=key))

def map_input(wildcards):
    return(PLATYPUS_IDIR+"/GRCh38.d1.vd1__"+all_map[wildcards.sample]+".platypus-recall.vcf.gz")


RENAMED_DIR='platypus'
rule all_rename:
    input: expand(RENAMED_DIR+"/{sample}.platypus-recall.vcf.gz", sample=all_map.keys())

rule rename:
    input: cmap="clones_map.txt", vcf=map_input
    output: RENAMED_DIR+"/{sample}.platypus-recall.vcf.gz"
    shell: 
        """
            bcftools reheader -s {input.cmap} -o {output} {input.vcf}
        """

PLATYPUS_DIR='platypus_recall'
PLATYPUS_IDIR='../platypus_recall'

LINES=['WIDR', 'DIFI']
##### pureCN to bed
PURE_DIR="../PureCN"
#WIDR_CLONE_12A_BULK/WIDR_CLONE_12A_BULK_dnacopy.seg
rule all_rename_pure:
    input: expand(RENAMED_DIR+"/{sample}_seg.bed", sample=all_map.keys())
def map_pure(wildcards):
    return(PURE_DIR+ "/" +all_map[wildcards.sample]+"/"+all_map[wildcards.sample]+"_dnacopy.seg")
rule pure_to_bed:
    input: map_pure
    output: RENAMED_DIR+"/{sample}_seg.bed"
    shell:
        """
            sed 1d {input} | bawk 'function ceil(x, y){{y=int(x); return(x>y?y+1:y)}} $2!="chrX" && $2!="chrY" {{print "chr"$2, ceil($3-0.5), int($4), int($7)}}' > {output}
        """


# DEPTH
ALIGN_DIR="../align"
def map_input_align(wildcards):
    return([ALIGN_DIR+"/realigned_"+all_map[wildcards.sample]+".sorted.cram", ALIGN_DIR+"/realigned_"+all_map[wildcards.sample]+".sorted.cram.crai"])

CORES=6
ALIGN_ODOCKER="d9582704189c"

rule all_coverage:
    input: map_input_align, ref='/mnt/trcanmed/snaketree/task/annotations/dataset/gnomad/GRCh38.d1.vd1.fa'
    output: "depth/{sample}.quantized.bed.gz"
    params: prefix="depth/{sample}", thread=CORES
    docker: ALIGN_ODOCKER
    shell:
        """
            mkdir -p depth;
            mosdepth -f {input.ref} -t {params.thread} -n --quantize 1: -Q 20 {params.prefix} {input[0]};
            rm {params.prefix}.mosdepth.global.dist.txt;
        """

# default skip 1796
#     read unmapped (0x4)
#         not primary alignment (0x100)
#             read fails platform/vendor quality checks (0x200)
#                 read is PCR or optical duplicate (0x400)
#(snakemake) [egrassi@occam CRC1307_clones]>zcat depth/CRC1307-08-1-D.quantized.bed.gz | cut -f 4 | sort | uniq 
#1:inf
rule all_int:
    input: expand("depth/{line}_callable_1x_20q.bed.gz", line=LINES)

def find_quantized(wildcards):
    if wildcards.line == 'WIDR':
        print(expand("depth/{sample}.quantized.bed.gz", sample=WIDR_CL))
        return(expand("depth/{sample}.quantized.bed.gz", sample=WIDR_CL))
    else:
        print(expand("depth/{sample}.quantized.bed.gz", sample=DIFI_CL))
        return(expand("depth/{sample}.quantized.bed.gz", sample=DIFI_CL))

def find_n_quantized(wildcards):
    if wildcards.line == 'WIDR':
        return(len(expand("depth/{sample}.quantized.bed.gz", sample=WIDR_CL)))
    else:
        return(len(expand("depth/{sample}.quantized.bed.gz", sample=DIFI_CL)))

rule intersect_1x:
    input: find_quantized
    output: "depth/{line}_callable_1x_20q.bed.gz"
    params: nsamples=find_n_quantized
    shell:
        """
            bedtools multiinter -i {input} | awk -F'\\t' -v OFS='\\t' '$4=={params.nsamples}' | gzip > {output}
        """

CALLABLE_BED='TODO'
rule intersect_callable:
    input: callable=CALLABLE_BED, covered="depth/callable_1x_20q.bed.gz"
    output: "depth/callable_covered.bed.gz"
    shell:
        """
            bedtools intersect -a {input.callable} -b {input.covered} | gzip > {output}
        """
    
########### old way, forget about it
rule header:
    input: PLATYPUS_IDIR+"/GRCh38.d1.vd1__WIDR_CLONE_12A_BULK.platypus-recall.vcf.gz"
    output: "header.txt"
    shell:
        """
            bcftools view -h {input} > {output}
        """

# plug in manually platypus filters info from /scratch/trcanmed/AF_spectra/local/share/data/CRC1307/platypus_filtered.vcf.gz

def find_clones(wildcards):
    if wildcards.line == 'WIDR':
        return(expand(PLATYPUS_DIR+"/GRCh38.d1.vd1__{sample}.platypus-recall.vcf.gz", sample=WIDR))
    else:
        return(expand(PLATYPUS_DIR+"/GRCh38.d1.vd1__{sample}.platypus-recall.vcf.gz", sample=DIFI))

rule all_filtered:
    input: expand(PLATYPUS_DIR+"/{line}_platypus_filtered.vcf.gz", line=LINES)
 
rule reheader:
    input: PLATYPUS_IDIR+"/GRCh38.d1.vd1__{sample}.platypus-recall.vcf.gz"
    output: PLATYPUS_DIR+"/GRCh38.d1.vd1__{sample}.platypus-recall.vcf.gz"
    params: lazy="header.txt"
    shell: 
        """
            bcftools reheader -h {params.lazy} {input} > {output}
            tabix {output}
        """

#GRCh38.d1.vd1__DIFI_CLONE_11_BULK.platypus-recall.vcf.gz
rule merge_vcf:
    input: find_clones
    output: PLATYPUS_DIR+"/{line}_merged.vcf.gz"
    shell:
        """
            bcftools merge --force-samples --missing-to-ref -o {output} -O z {input};
            tabix {output};
        """

rule pass_platypus:
    output: PLATYPUS_DIR+"/pass"
    shell:
        """
            echo -en "recall;PASS\\nPASS\\nrecall;alleleBias\\n" | tr "," "\\n" > {output}
        """

rule filter_platypus:
    input: vcf=PLATYPUS_DIR+"/{line}_merged.vcf.gz", keep=PLATYPUS_DIR+"/pass"
    output: PLATYPUS_DIR+"/{line}_platypus_filtered.vcf.gz"
    shell:
        """
            zcat {input.vcf} | grep -v "^#"| filter_1col 7 {input.keep} | grep -v '\./\.' > {output}.tmp;
            cat <(zcat {input.vcf} | grep "^#") {output}.tmp | bgzip > {output};
            tabix {output};
            rm {output}.tmp;
        """

# bcftools reheader -N file -o    file is old_name !space! new_name
